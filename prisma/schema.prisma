generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  PUBLISHER
  ADMIN
}

enum Tier {
  FREE
  PREMIUM
}

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  fullName         String?   @map("full_name")
  // Set at signup for teacher (PUBLISHER) accounts — lets readers filter
  // resources by the publishing teacher's institution.
  institution      String?
  role             Role      @default(STUDENT)
  tier             Tier      @default(FREE)
  // Null means no expiry (e.g. admin-granted premium). Set on purchased
  // subscriptions — see src/lib/subscription.ts.
  premiumExpiresAt DateTime? @map("premium_expires_at")
  avatarUrl        String?   @map("avatar_url")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  resources             Resource[]
  purchases             Purchase[]
  downloads             DownloadLog[]
  subscriptionPurchases SubscriptionPurchase[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  resources Resource[]

  @@map("categories")
}

model Subject {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  resources Resource[]

  @@map("subjects")
}

model Resource {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  description String
  fileUrl     String?  @map("file_url")
  coverUrl    String?  @map("cover_url")
  price       Decimal  @default(0) @db.Decimal(10, 2)
  isFree      Boolean  @default(true) @map("is_free")
  isPublished Boolean  @default(false) @map("is_published")
  fileType    String?  @map("file_type")
  pageCount   Int?     @map("page_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  categoryId String   @map("category_id") @db.Uuid
  category   Category @relation(fields: [categoryId], references: [id])

  subjectId String?  @map("subject_id") @db.Uuid
  subject   Subject? @relation(fields: [subjectId], references: [id])

  createdById String @map("created_by_id") @db.Uuid
  createdBy   User   @relation(fields: [createdById], references: [id])

  purchases Purchase[]
  downloads DownloadLog[]

  @@map("resources")
}

model Purchase {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  resourceId        String   @map("resource_id") @db.Uuid
  amountPaid        Decimal  @map("amount_paid") @db.Decimal(10, 2)
  externalReference String?  @unique @map("external_reference")
  campayReference   String?  @unique @map("campay_reference")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [id])

  @@unique([userId, resourceId])
  @@map("purchases")
}

// A Premium subscription purchase via CamPay. CamPay only supports one-off
// collections, not recurring billing, so "subscription" here means a
// time-boxed grant — see src/lib/subscription.ts for the price/duration and
// the grant/extend logic applied once CamPay confirms payment.
model SubscriptionPurchase {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  amountPaid        Decimal  @map("amount_paid") @db.Decimal(10, 2)
  durationDays      Int      @map("duration_days")
  externalReference String?  @unique @map("external_reference")
  campayReference   String?  @unique @map("campay_reference")
  status            String   @default("PENDING")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("subscription_purchases")
}

// Records every successful resource download. Used to enforce the FREE tier's
// weekly cap on free-resource downloads (PREMIUM users are exempt) — see
// src/app/api/resources/[id]/download/route.ts.
model DownloadLog {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  resourceId   String   @map("resource_id") @db.Uuid
  downloadedAt DateTime @default(now()) @map("downloaded_at")

  user     User     @relation(fields: [userId], references: [id])
  resource Resource @relation(fields: [resourceId], references: [id])

  @@index([userId, downloadedAt])
  @@map("download_logs")
}
